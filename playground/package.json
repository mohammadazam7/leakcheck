{
  "name": "leakcheck-playground",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Try leakcheck in the browser: the real Python package and pyarrow run in the page through Pyodide, on sample data or on two CSV files that never leave the machine.",
  "scripts": {
    "prepare-py": "bash scripts/prepare-py.sh",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "5.2.7",
    "@fontsource/schibsted-grotesk": "5.3.0",
    "pyodide": "0.27.7"
  },
  "devDependencies": {
    "@types/node": "22.10.1",
    "typescript": "5.6.3",
    "vite": "5.4.11",
    "vitest": "2.1.5"
  }
}
